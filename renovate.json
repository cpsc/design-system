{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Packages (bun.lock), action digests and flake.lock (lock file maintenance). Vendored files move with the geist package version or by hand, never by Renovate.",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "schedule": ["* 0-5 * * 1"],
  "labels": ["dependencies"],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "enabledManagers": ["bun", "github-actions", "nix"],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 0-5 * * 1"] },
  "packageRules": [
    {
      "description": "One pull request for compatible package updates; majors stay separate.",
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "packages (non-major)"
    },
    {
      "description": "A peer range is what apps must provide: widen it on purpose, not on every release.",
      "matchManagers": ["bun"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
