{
  // Apps compile src/ themselves: keep these options no looser than the Zeabur app's.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.src.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["bun", "vite/client", "unplugin-icons/types/react"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Only for the shadcn CLI; the sources never use it. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "stories", ".storybook/preview.tsx"]
}
